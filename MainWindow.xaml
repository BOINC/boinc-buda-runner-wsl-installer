<Window x:Class="boinc_buda_runner_wsl_installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:boinc_buda_runner_wsl_installer"
        mc:Ignorable="d"
        Title="{Binding ApplicationTitleWithVersion}"
        Height="395"
        Width="515"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        FocusManager.FocusedElement="{Binding ElementName=InstallButton}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Image Source="/banner.png"/>
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="IntroTextBlockHeader"
                               Grid.Column="1"
                               Grid.Row="0"
                               Text="{Binding ApplicationWelcomeHeader}"
                               TextAlignment="Left"
                               VerticalAlignment="Top"
                               HorizontalAlignment="Left"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="Black"
                               TextWrapping="Wrap"
                               Margin="40 10 0 10"
                               Focusable="False"
                    />
                    <!-- Intro text shown before installation starts -->
                    <TextBlock x:Name="IntroTextBlock"
                           Grid.Column="1"
                           Grid.Row="1"
                           Text="This will install the BOINC Linux applications support, allowing BOINC to run Linux jobs based on Docker.&#x0a;&#x0a;Click Install to continue."
                           TextAlignment="Left"
                           VerticalAlignment="Top"
                           HorizontalAlignment="Left"
                           FontSize="12"
                           Foreground="Black"
                           TextWrapping="Wrap"
                           Margin="40 40 10 0"
                           Focusable="False"/>

                    <!-- Table area -->
                    <ItemsControl Grid.Row="1"
                                  Grid.Column="1"
                                  ItemsSource="{Binding TableItems}"
                                  Margin="10"
                                  Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="16" Height="16" Margin="5" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Icon}" Value="BlueInfoIcon">
                                                        <Setter Property="Background" Value="{StaticResource BlueInfoIcon}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Icon}" Value="GreenCheckboxIcon">
                                                        <Setter Property="Background" Value="{StaticResource GreenCheckboxIcon}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Icon}" Value="RedCancelIcon">
                                                        <Setter Property="Background" Value="{StaticResource RedCancelIcon}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Icon}" Value="YellowExclamationIcon">
                                                        <Setter Property="Background" Value="{StaticResource YellowExclamationIcon}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                    <TextBlock Text="{Binding Status}" Grid.Column="1" Margin="5" MinHeight="16" TextWrapping="Wrap"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Grid>
            <Separator Grid.Row="1" Margin="0"/>
            <!-- Bottom panel with buttons -->
            <Grid Grid.Row="2" Margin="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Open Log on the left -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Button Name="OpenLogButton" Content="Open Log" Width="85" Height="20" Margin="10" Click="OpenLogButton_Click" TabIndex="3"/>
                </StackPanel>

                <!-- Install/Uninstall/Exit on the right -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Name="InstallButton" Content="Install" Width="85" Height="20" Margin="10 10 5 10" Click="InstallButton_Click" TabIndex="0" IsDefault="True"/>
                    <Button Name="UninstallButton" Content="Uninstall" Width="85" Height="20" Margin="5 10 5 10" Click="UninstallButton_Click" TabIndex="1"/>
                    <Button Name="ExitButton" Content="Exit" Width="85" Height="20" Margin="5 10 10 10" Click="ExitButton_Click" TabIndex="2" IsCancel="True"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
